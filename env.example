# DB設定
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# DB接続URL
DATABASE_URL=

# 認証用設定
NEXTAUTH_SECRET=

# Google API認証キー
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_EMBED_API_KEY=

# 画像ストレージ（未設定なら local）
IMAGE_STORAGE_DRIVER=local
# local ドライバの保存先（未設定なら <リポジトリ直下>/public/images）
IMAGE_STORAGE_LOCAL_DIR=
# 参照パスの接頭辞（未設定なら /images）。IMAGE_STORAGE_LOCAL_DIR と対応させること
IMAGE_STORAGE_BASE_PATH=
